# LLM Configuration
LLM_PROVIDER=mock  # Options: mock, anthropic, openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database
DATABASE_PATH=data/guardrail.db

# Logging
LOG_LEVEL=INFO

# Policy Configuration
MAX_AUTO_APPROVE_AMOUNT=2000
MIN_CONFIDENCE_THRESHOLD=0.75

# Application
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true